<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The launcher icon is fully rendered in the background layer
          (@drawable/ic_launcher_background), so this layer is intentionally
          transparent. It must still contain at least one <path>: Android's
          VectorDrawable throws "no path defined" for a <vector> with no paths,
          which makes the whole adaptive icon fail to load and the launcher
          fall back to the generic Android robot icon. -->
     <path
         android:fillColor="#00000000"
         android:pathData="M0,0h1v1h-1z" />
</vector>
